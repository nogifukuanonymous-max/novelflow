# ══════════════════════════════════════════════════
# NovelFlow — 環境変数テンプレート
# このファイルを .env.local にコピーして値を入力してください
# .env.local は .gitignore に必ず含めること
# ══════════════════════════════════════════════════

# ── Supabase ──
# Supabase ダッシュボード → Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# サーバー側のみで使用（クライアントには公開しない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── .nvp 署名シークレット ──
# 任意の強いランダム文字列（最低64文字）
NVP_SECRET=your_very_strong_random_secret_key_here_at_least_64_chars

# ── Next.js ──
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ── Cloudflare R2 / AWS S3 ──
R2_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=novelflow-assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.novelflow.app

# ── 本番環境のみ ──
# NEXT_PUBLIC_APP_URL=https://novelflow.app
